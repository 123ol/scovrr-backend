NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/scovrr
JWT_ACCESS_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-development-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Payment provider is intentionally credential-gated.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CALLBACK_URL=

# Subscription billing defaults are minor currency units (NGN kobo).
DEFAULT_BUSINESS_PLAN_CODE=FREE
SUBSCRIPTION_CURRENCY=NGN
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_MAX_RETRY_ATTEMPTS=3
SUBSCRIPTION_RETRY_INTERVAL_MINUTES=60
TRIAL_DURATION_DAYS=0
SUBSCRIPTION_PRO_MONTHLY_AMOUNT_MINOR=1500000
SUBSCRIPTION_PRO_YEARLY_AMOUNT_MINOR=15000000
SUBSCRIPTION_BUSINESS_PLUS_MONTHLY_AMOUNT_MINOR=5000000
SUBSCRIPTION_BUSINESS_PLUS_YEARLY_AMOUNT_MINOR=50000000

# Sponsored discovery is prepaid, server-metered, and provider-independent.
PROMOTION_EVENT_SECRET=replace-with-a-dedicated-promotion-event-secret
PROMOTION_IMPRESSION_COST_MINOR=100
PROMOTION_ATTRIBUTION_WINDOW_DAYS=7

# Analytics is privacy-bounded and failure-isolated from commerce.
ANALYTICS_BEHAVIORAL_RETENTION_DAYS=395
ANALYTICS_SEARCH_RETENTION_DAYS=90
ANALYTICS_BATCH_MAX_EVENTS=50
ANALYTICS_OUTBOX_BATCH_SIZE=100

PLATFORM_COMMISSION_BPS=1000
PAYOUT_HOLD_DAYS=7
AUTO_PAYOUTS_ENABLED=false
RECONCILIATION_ENABLED=false
# Protects the Vercel Cron / external scheduler endpoint.
CRON_SECRET=replace-with-a-random-secret
EXPO_ACCESS_TOKEN=
MEDIA_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CATALOGUE_IMAGE_MAX_BYTES=10485760
CATALOGUE_VIDEO_MAX_BYTES=52428800
CORS_ALLOWED_ORIGINS=http://localhost:5173
